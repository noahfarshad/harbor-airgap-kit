# --- catalog refresh (connected side) ----------------------------------------------------

PLAIN_VERSION = r"\d+(?:\.\d+)+(?:-\d{8})?"     # 1.33.5, 3.7.0-20260924, 2025.8.19; not -rc, not latest
PRERELEASE = re.compile(r"(?i)[-._](rc|alpha|beta|dev|pre)\.?\d*")


class Registry(object):
    """Anonymous reads from a registry's v2 API: its repositories and their tags."""

    def __init__(self, host):
        self.host = host
        self.tokens = {}
        self.cache = {}

    def get(self, path, scope):
        """One page of JSON from https://<host><path>, and the path of the next page."""
        if "://" in path:
            path = "/" + path.split("/", 3)[3]
        for attempt in (1, 2):
            headers = {"Accept": "application/json"}
            if self.tokens.get(scope):
                headers["Authorization"] = "Bearer " + self.tokens[scope]
            try:
                with urllib.request.urlopen(request("https://%s%s" % (self.host, path), headers=headers),
                                            timeout=60) as response:
                    body = json.loads(response.read().decode("utf-8"))
                    link = re.search(r"<([^>]+)>", response.headers.get("Link") or "")
                return body, (link.group(1) if link else None)
            except urllib.error.HTTPError as error:
                challenge = error.headers.get("WWW-Authenticate", "") if error.headers else ""
                params = dict(re.findall(r'(\w+)="([^"]*)"', challenge))
                if error.code != 401 or attempt == 2 or "realm" not in params:
                    raise
                query = {"scope": scope}
                if "service" in params:
                    query["service"] = params["service"]
                with urllib.request.urlopen(request(params["realm"] + "?" + urllib.parse.urlencode(query)),
                                            timeout=30) as response:
                    token = json.loads(response.read().decode("utf-8"))
                self.tokens[scope] = token.get("token") or token.get("access_token") or ""
        return {}, None

    def pages(self, path, scope, key):
        if path not in self.cache:
            found, pages, next_path = [], 0, path
            while next_path and pages < 200:
                body, next_path = self.get(next_path, scope)
                found += body.get(key) or []
                pages += 1
            self.cache[path] = found
        return self.cache[path]

    def repositories(self):
        return self.pages("/v2/_catalog?n=1000", "registry:catalog:*", "repositories")

    def tags(self, repo):
        try:
            return self.pages("/v2/%s/tags/list?n=1000" % repo, "repository:%s:pull" % repo, "tags")
        except urllib.error.HTTPError as error:
            if error.code in (403, 404):
                return []
            raise


def ref_template(ref, version):
    """A reference with its version swapped for {v}: (host, path, tag)."""
    parts = parse_ref(ref)
    return parts["host"], parts["path"].replace(version, "{v}"), parts["tag"].replace(version, "{v}")


def template_regex(text):
    """A regex for a template, with the version as group 1 (repeated if {v} appears twice)."""
    pieces = re.escape(text).split(re.escape("{v}"))
    body = pieces[0]
    for n, piece in enumerate(pieces[1:]):
        body += ("(%s)" % PLAIN_VERSION if n == 0 else r"\1") + piece
    return re.compile("^%s$" % body)


def catalog_groups(item):
    """An item's versions grouped by how their first reference is named, newest naming first."""
    groups = []
    for version, refs in item["versions"].items():
        host, path, tag = ref_template(refs[0], version)
        group = next((g for g in groups if g["path"] == path), None)
        if group is None:
            group = {"host": host, "path": path, "tags": [], "versions": []}
            groups.append(group)
        group["versions"].append(version)
        if tag not in group["tags"]:
            group["tags"].append(tag)
    return groups


def refs_for(item, group, version, registry):
    """The references a new version gets, modeled on the newest version named the same way.
    None when the main one has no tag for it; extra images the version doesn't have are left out."""
    base = max(group["versions"], key=version_key)
    refs = []
    for n, ref in enumerate(item["versions"][base]):
        host, path_t, tag_t = ref_template(ref, base)
        path = path_t.replace("{v}", version)
        tags = registry.tags(path)
        tag = tag_t.replace("{v}", version)
        if tag not in tags:
            close = [t for t in tags if version in t and not t.startswith("sha256-") and not PRERELEASE.search(t)]
            if not close:
                if n == 0:
                    return None
                continue
            tag = max(close, key=version_key)
        ref = "%s/%s:%s" % (host, path, tag)
        if not registry_probe(ref)[0]:        # listed is not the same as pullable: ask for it
            if n == 0:
                return None
            continue
        refs.append(ref)
    return refs


def newer_versions(item, registry, repos):
    """What the registry has that the item doesn't list yet: the newest patch of a line it already
    has, when that's newer than what it has, and the newest patch of any newer line.
    {version: {refs, kind: patch|line, group}}"""
    newest = {}
    for v in item["versions"]:
        newest[version_line(v)] = max(newest.get(version_line(v), ()), version_key(v))
    found = {}
    for group in catalog_groups(item):
        candidates = set()
        if "{v}" in group["path"]:
            rx = template_regex(group["path"])
            candidates = {m.group(1) for m in (rx.match(repo) for repo in repos) if m}
        else:
            tags = registry.tags(group["path"])
            for tag_t in group["tags"]:
                rx = template_regex(tag_t)
                candidates |= {m.group(1) for m in (rx.match(tag) for tag in tags) if m}
        best = {}
        for version in candidates:
            line = version_line(version)
            if line not in best or version_key(version) > version_key(best[line]):
                best[line] = version
        group_top = max(version_line(v) for v in group["versions"])
        for line, version in sorted(best.items(), reverse=True):
            if version in item["versions"] or version in found:
                continue
            if line in newest and version_key(version) > newest[line]:
                kind = "patch"
            elif line not in newest and line > group_top:
                kind = "line"
            else:
                continue
            refs = refs_for(item, group, version, registry)
            if refs:
                found[version] = {"refs": refs, "kind": kind, "group": group["path"]}
    return found


def check_refs(catalog):
    """Every reference in the catalog, asked for anonymously: {ref: (answered, detail)}."""
    refs = sorted({ref for item in catalog.values() for refs in item["versions"].values() for ref in refs})
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        return dict(zip(refs, pool.map(registry_probe, refs)))


def not_in_catalog(catalog, repos):
    """Supervisor Service repositories under a name the catalog doesn't use at all, so another
    naming or a component image of an item it has doesn't count: {name: (newest version, repository)}."""
    known = set()
    for item in catalog.values():
        for version, refs in item["versions"].items():
            for ref in refs:
                known |= set(ref_template(ref, version)[1].split("/"))
    names = {}
    for repo in repos:
        match = re.match(r"^vsphere/(?:supervisor|iaas)/([^/]+)/([^/]+)/", repo)
        if not match or match.group(1) in known:
            continue
        name, version = match.groups()
        if not re.match("^%s$" % PLAIN_VERSION, version):
            names.setdefault(name, ("", repo))
        elif not names.get(name, ("",))[0] or version_key(version) > version_key(names[name][0]):
            names[name] = (version, repo)
    return names


def item_bounds(lines, key):
    start = next(i for i, line in enumerate(lines) if re.match(r"^%s:\s*(#.*)?$" % re.escape(key), line))
    end = next((i for i in range(start + 1, len(lines)) if re.match(r"^[^\s#]", lines[i])), len(lines))
    return start, end


def item_entries(lines, start, end):
    """An item's versions as they sit in the file: [[version, first line, the line after it]]."""
    entries = []
    for i in range(start, end):
        match = re.match(r'^    "?([^":\s]+)"?:', lines[i])
        if match:
            entries.append([match.group(1), i, i + 1])
        elif entries and lines[i].startswith("      "):
            entries[-1][2] = i + 1
    return entries


def yaml_text(text):
    """Free text as one double-quoted YAML string."""
    return '"%s"' % " ".join(str(text).split()).replace("\\", "/").replace('"', "'")


def rewrite_catalog(text, catalog, changes, checked):
    """catalog.yml with the agreed changes made and every comment and other line left as it was.
    changes: {item: {"add": {version: {"refs", "group"}}, "remove": [versions],
                     "default": version, "hold": reason, or "" to clear it}}"""
    lines = text.splitlines(True)
    for key, change in changes.items():
        item = catalog[key]
        for version in sorted(change.get("add") or {}, key=version_key, reverse=True):
            new = change["add"][version]
            start, end = item_bounds(lines, key)
            entries = item_entries(lines, start, end)
            same = [e for e in entries if e[0] in item["versions"]
                    and ref_template(item["versions"][e[0]][0], e[0])[1] == new["group"]]
            older = [e for e in same if version_key(e[0]) < version_key(version)]
            at = older[0][1] if older else (same[-1][2] if same else entries[0][1])
            refs = new["refs"]
            lines[at:at] = (['    "%s": %s\n' % (version, refs[0])] if len(refs) == 1 else
                            ['    "%s":\n' % version] + ["      - %s\n" % ref for ref in refs])
        for version in change.get("remove") or []:
            start, end = item_bounds(lines, key)
            for entry in reversed(item_entries(lines, start, end)):
                if entry[0] == version:
                    del lines[entry[1]:entry[2]]
        if "hold" in change:
            start, end = item_bounds(lines, key)
            lines[start:end] = [line for line in lines[start:end] if not re.match(r"^  hold:", line)]
        start, end = item_bounds(lines, key)
        for i in range(start, end):
            match = re.match(r'^(  default:\s*)("?)[^"#\s]*\2(.*)$', lines[i].rstrip("\n"))
            if match:
                if change.get("default"):
                    lines[i] = '%s"%s"%s\n' % (match.group(1), change["default"], match.group(3))
                if change.get("hold"):
                    lines.insert(i + 1, "  hold: %s\n" % yaml_text(change["hold"]))
                break
    if checked and not any(re.match(r"^# Last checked:", line) for line in lines):
        # An older catalog without the line gets one at the end of its opening comments.
        at = next((i for i, line in enumerate(lines) if not line.startswith("#")), len(lines))
        lines[at:at] = ["#\n", "# Last checked: %s\n" % checked]
    text = "".join(lines)
    if checked:
        text = re.sub(r"(?m)^(# Last checked:[ \t]*)\d{4}-\d{2}-\d{2}", r"\g<1>" + checked, text, count=1)
    return text


def pinned(value):
    """The versions an environment pins for an item: a version or a list of them. true and false pin nothing."""
    if isinstance(value, bool) or value is None:
        return []
    return [str(v) for v in value] if isinstance(value, list) else [str(value)]


def move_pin(env, key, old, new, catalog):
    """Change one version an environment pins in its broadcom.yml, on that item's line only, and
    keep the change only if the inventory still reads cleanly. Returns the file, or None."""
    rel = Inventory(env).where("broadcom_items")
    path = os.path.join(REPO, rel)
    if not os.path.isfile(path):
        return None
    with open(path, encoding="utf-8") as handle:
        before = handle.read()
    lines, inside, done = before.splitlines(True), False, False
    for i, line in enumerate(lines):
        if re.match(r"^broadcom_items:", line):
            inside = True
            continue
        if inside and re.match(r"^[^\s#]", line):
            break
        match = re.match(r"^(\s+%s:)(.*)$" % re.escape(key), line) if inside else None
        if match:
            value, sep, comment = match.group(2).partition("#")
            for pattern in (r'"%s"' % re.escape(old), r"'%s'" % re.escape(old), r"(?<![\w.])%s(?![\w.])" % re.escape(old)):
                changed = re.sub(pattern, lambda m: m.group(0).replace(old, new), value, count=1)
                if changed != value:
                    lines[i] = match.group(1) + changed + sep + comment + ("\n" if line.endswith("\n") else "")
                    done = True
                    break
            break
    if not done:
        return None
    with open(path, "w", encoding="utf-8") as handle:
        handle.write("".join(lines))
    choices, problems = wanted_items(Inventory(env), catalog)
    if problems or new not in choices.get(key, []):
        with open(path, "w", encoding="utf-8") as handle:
            handle.write(before)
        return None
    return rel


def interactive():
    return sys.stdin.isatty() and sys.stdout.isatty()


def ask(question, default):
    """Yes or no at the terminal. Enter takes the default, shown in capitals."""
    while True:
        try:
            answer = input("    %s %s " % (question, "[Y/n]" if default else "[y/N]")).strip().lower()
        except EOFError:
            print("")
            return default
        if not answer:
            return default
        if answer in ("y", "yes"):
            return True
        if answer in ("n", "no"):
            return False
        print("    y or n, please")


def ask_text(question):
    try:
        return input("    %s " % question).strip()
    except EOFError:
        print("")
        return ""


def decide(question, recommended, mode):
    """Ask in a terminal; otherwise show the recommended answer, which --yes then takes."""
    if mode == "ask":
        return ask(question, recommended)
    print("    %s %s" % (question, "yes" if recommended else "no"))
    return recommended


def refresh_catalog(path, catalog, mode, why_report=""):
    """mode: ask (a terminal), yes (take every recommended answer) or report (change nothing)."""
    rel = os.path.relpath(path, REPO)
    today = datetime.date.today().isoformat()
    hosts = sorted({parse_ref(ref)["host"] for item in catalog.values()
                    for refs in item["versions"].values() for ref in refs})

    step("Checking %s against %s" % (rel, ", ".join(hosts)))
    results = check_refs(catalog)
    failed = {ref: detail for ref, (ok, detail) in results.items() if not ok}
    if results and len(failed) == len(results):
        die("none of the %d references answered (%s). Is %s reachable from here? Nothing was changed"
            % (len(results), sorted(failed.values())[0], ", ".join(hosts)))
    for ref, detail in sorted(failed.items()):
        row("FAIL", ref, detail)
    row("OK" if not failed else "WARN", "%d of %d references answer without a login" % (len(results) - len(failed), len(results)))
    # Gone means the registry said so. A timeout or a 5xx is the network, not Broadcom removing it.
    gone = {(key, version) for key, item in catalog.items() for version, refs in item["versions"].items()
            if failed.get(refs[0]) == "HTTP 404"}

    step("Looking for newer versions")
    added, registries = {}, {}
    try:
        for host in hosts:
            registry = Registry(host)
            try:
                repos = registry.repositories()
            except urllib.error.HTTPError as error:
                repos = []
                row("WARN", "%s won't list its repositories (HTTP %s)" % (host, error.code),
                    "so new versions named by path can't be found; check Broadcom's release notes")
            registries[host] = (registry, repos)
            log("%d repositories in %s" % (len(repos), host))
        for key, item in catalog.items():
            registry, repos = registries[parse_ref(item["versions"][item["default"]][0])["host"]]
            new = newer_versions(item, registry, repos)
            if new:
                added[key] = new
    except (OSError, http.client.HTTPException, ValueError) as error:
        die("could not read %s (%s). Run this on the connected workstation; nothing was changed"
            % (", ".join(hosts), getattr(error, "reason", error)))
    if not added:
        row("OK", "nothing newer: every item has the newest patch of each line it carries")
    for key, new in added.items():
        default_line = version_line(catalog[key]["default"])
        for version in sorted(new, key=version_key, reverse=True):
            line = version_line(version)
            note = ("newer patch of the default's line" if line == default_line else
                    "newer line than the default" if line > default_line else
                    "newer patch of %s" % ".".join(str(n) for n in line))
            row("NEW", "%s %s" % (key, version), "%s (default %s)" % (note, catalog[key]["default"]), width=34)

    usage = {}
    for env in environment_names():
        raw = Inventory(env).vars.get("broadcom_items")
        for key, value in (raw.items() if isinstance(raw, dict) else []):
            entry = usage.setdefault(str(key), {"follow": [], "pins": []})
            if value is True:
                entry["follow"].append(env)
            entry["pins"] += [(env, v) for v in pinned(value)]

    step({"ask": "Your call on each change", "yes": "Taking the recommended answers",
          "report": "What it would ask, with the recommended answers"}[mode])
    changes, pin_moves, asked = {}, [], False
    for key, item in catalog.items():
        new = added.get(key, {})
        use = usage.get(key, {"follow": [], "pins": []})
        default, change = item["default"], {}
        if new:
            change["add"] = new
        followers = ", ".join(use["follow"]) or "no environment"

        patch = max((v for v in new if version_line(v) == version_line(default)
                     and version_key(v) > version_key(default)), key=version_key, default=None)
        if patch:
            asked = True
            if item.get("hold"):
                print("    %s is held at %s: %s" % (key, default, item["hold"]))
            if decide("%s: make %s the default instead of %s? (%s follows the default)"
                      % (key, patch, default, followers), not item.get("hold"), mode):
                change.update(default=patch, hold="")
            elif mode == "ask" and not item.get("hold"):
                reason = ask_text("Why keep %s? It's saved in %s for whoever runs this next (Enter to skip):" % (default, rel))
                change["hold"] = "%s (%s, %s)" % (reason or "kept %s" % default, getpass.getuser(), today)

        ahead = max((v for v in new if version_line(v) > version_line(default)), key=version_key, default=None)
        if ahead and not change.get("default"):
            asked = True
            if decide("%s: %s is on a newer line. Make it the default instead of %s? Read its release notes first."
                      % (key, ahead, default), False, mode):
                change.update(default=ahead, hold="")

        available = set(item["versions"]) | set(new)
        for env, version in use["pins"]:
            better = max((v for v in available if version_line(v) == version_line(version)
                          and version_key(v) > version_key(version)), key=version_key, default=None)
            if version in available and better:
                asked = True
                if decide("%s pins %s %s. Move it to %s, the newest patch of that line?" % (env, key, version, better),
                          False, mode):
                    pin_moves.append((env, key, version, better))

        removed = []
        for version in item["versions"]:
            if (key, version) not in gone:
                continue
            users = sorted({env for env, v in use["pins"] if v == version} | (set(use["follow"]) if version == default else set()))
            if version == default:
                row("FAIL", "%s %s" % (key, version), "is the default and Broadcom's registry no longer has it: choose another", width=34)
            elif users:
                row("WARN", "%s %s" % (key, version), "is gone from Broadcom's registry; kept because %s uses it" % ", ".join(users), width=34)
            else:
                asked = True
                if decide("%s %s is gone from Broadcom's registry and nothing uses it. Remove it from the catalog?"
                          % (key, version), True, mode):
                    removed.append(version)
        if removed:
            change["remove"] = removed
        if change:
            changes[key] = change
    if not asked:
        row("OK", "nothing to decide")

    held = [(key, item) for key, item in catalog.items() if item.get("hold") and changes.get(key, {}).get("hold") != ""]
    if held:
        step("Held")
        for key, item in held:
            row("", "%s at %s" % (key, item["default"]), item["hold"], width=34)

    others = {}
    for registry, repos in registries.values():
        others.update(not_in_catalog(catalog, repos))
    if others:
        step("In the registry under names the catalog doesn't use")
        for name in sorted(others):
            version, repo = others[name]
            row("", name, ("newest %s: %s" % (version, repo)) if version else repo, width=38)
        log("Not every one is something you install. Add one by hand if an environment needs it.")

    if mode == "report":
        step("Nothing was changed")
        if why_report:
            log(why_report)
        print("    python3 kit catalog --refresh          asks about each change, in a terminal")
        print("    python3 kit catalog --refresh --yes    takes the recommended answers")
        return

    removed_refs = {refs[0] for key, change in changes.items() for v in change.get("remove", [])
                    for refs in [catalog[key]["versions"][v]]}
    all_answer = all(ref in removed_refs for ref in failed)
    with open(path, encoding="utf-8") as handle:
        old = handle.read()
    text = rewrite_catalog(old, catalog, changes, today if all_answer else None)
    if text != old:
        tmp = path + ".new"
        with open(tmp, "w", encoding="utf-8") as handle:
            handle.write(text)
        try:
            updated = load_catalog(tmp)
        except KitError:
            os.remove(tmp)
            die("the updated catalog did not load (see above), so %s is unchanged" % rel, 2)
        shutil.copyfile(path, path + ".previous")
        os.replace(tmp, path)
    else:
        updated = catalog

    step("Done")
    for key, change in changes.items():
        parts = []
        if change.get("add"):
            parts.append("added " + ", ".join(sorted(change["add"], key=version_key, reverse=True)))
        if change.get("remove"):
            parts.append("removed " + ", ".join(change["remove"]))
        if change.get("default"):
            parts.append("default %s -> %s" % (catalog[key]["default"], change["default"]))
        if change.get("hold"):
            parts.append("held at %s" % catalog[key]["default"])
        elif change.get("hold") == "" and catalog[key].get("hold"):
            parts.append("hold cleared")
        row("", key, "; ".join(parts), width=34)
    for env, key, version, better in pin_moves:
        where = move_pin(env, key, version, better, updated)
        if where:
            row("OK", "%s: %s %s -> %s" % (env, key, version, better), "in " + where, width=34)
        else:
            row("WARN", "%s: %s %s -> %s" % (env, key, version, better),
                "not changed: edit %s by hand" % Inventory(env).where("broadcom_items"), width=34)
    if text != old:
        log("Wrote %s; the one before is %s.previous" % (rel, rel))
    log("Last checked: %s" % (today if all_answer else "unchanged, because not every reference answered"))
    if changes or pin_moves:
        log("Next: python3 kit check, then fetch as usual.")


def cmd_catalog(args):
    path = repo_path("broadcom/catalog.yml")
    catalog = load_catalog(path)
    if not catalog:
        die("there is no broadcom/catalog.yml in %s" % REPO)
    if args.refresh or args.yes or args.dry_run:
        if args.dry_run:
            refresh_catalog(path, catalog, "report")
        elif args.yes:
            refresh_catalog(path, catalog, "yes")
        elif interactive():
            refresh_catalog(path, catalog, "ask")
        else:
            refresh_catalog(path, catalog, "report", "This isn't a terminal, so there was no one to ask.")
        return
    envs = [args.env] if args.env else environment_names()
    turned_on = {}
    for env in envs:
        choices, problems = wanted_items(Inventory(env), catalog)
        for problem in problems:
            row("FAIL", problem)
        for key, versions in choices.items():
            for version in versions:
                turned_on.setdefault(key, []).append("%s %s" % (env, version))
    step("broadcom/catalog.yml: what each environment can turn on in group_vars/registry/broadcom.yml")
    for key, item in catalog.items():
        versions = list(item["versions"])
        print("")
        row("", key, item.get("name", ""), width=28)
        row("", "", "versions %s (default %s); goes to Harbor project %s" % (
            ", ".join(versions[:6]) + (", ..." if len(versions) > 6 else ""), item["default"], item["project"]), width=28)
        if item.get("needs"):
            row("", "", "needs " + str(item["needs"]), width=28)
        if item.get("hold"):
            row("", "", "held at %s: %s" % (item["default"], item["hold"]), width=28)
        row("", "", "on in: " + (", ".join(turned_on.get(key, [])) or "none of %s" % ", ".join(envs)), width=28)
    print("")


# --- entry point -------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(prog="python3 kit", description=__doc__.split("\n\n")[0],
                                     epilog="Run 'python3 kit <command> --help' for each command.")
    parser.add_argument("--config", default=os.path.join(REPO, "kit.yml"), help="default: kit.yml next to this tool")
    commands = parser.add_subparsers(dest="command", metavar="command")

    commands.add_parser("check", help="check kit.yml, the tools, and that every source can be reached")
    commands.add_parser("fetch", help="download and verify everything into one transfer folder")
    catalog = commands.add_parser("catalog", help="what broadcom/catalog.yml offers and what each environment turns on")
    catalog.add_argument("--env", help="only this inventory")
    catalog.add_argument("--refresh", action="store_true",
                         help="check every reference, look for newer versions in Broadcom's registry, and ask "
                              "yes or no before changing anything")
    catalog.add_argument("--yes", action="store_true",
                         help="with --refresh, for unattended runs: take every recommended answer")
    catalog.add_argument("--write", dest="yes", action="store_true", help=argparse.SUPPRESS)
    catalog.add_argument("--dry-run", action="store_true",
                         help="with --refresh: show what it would ask, change nothing")

    choose = commands.add_parser("choose", help="pick the Broadcom content an environment gets, before a fetch")
    choose.add_argument("--env", required=True, help="the inventory under inventories/, e.g. dev")
    verify = commands.add_parser("verify", help="check a transfer (--from), or an environment's registry (--env)")
    which = verify.add_mutually_exclusive_group(required=True)
    which.add_argument("--from", dest="from_dir", metavar="DIR", help="a transfer folder, against its SHA256SUMS")
    which.add_argument("--env", help="the environment whose registry to check, e.g. dev")

    publish = commands.add_parser("publish", help="inside: check the transfer and stage it, uploading the Harbor "
                                                  "files to Nexus when the environment uses one")
    publish.add_argument("--from", dest="from_dir", required=True, metavar="DIR", help="the transfer folder")
    publish.add_argument("--env", required=True, help="the inventory under inventories/, e.g. prod")
    publish.add_argument("--nexus", help="Nexus URL, when the inventory has nexus_enabled: true; default nexus_url")
    publish.add_argument("--cacert", help="CA bundle for Nexus's certificate, e.g. /etc/ipa/ca.crt")
    publish.add_argument("--staging", help="default artifact_staging from the inventory")
    publish.add_argument("--skip-nexus", action="store_true", help="stage only; publish later")

    setup = commands.add_parser("setup", help="inside: answer a few questions and the environment's inventory, "
                                              "certificate and vault are written for you")
    setup.add_argument("--env", required=True, help="the inventory under inventories/, e.g. dev")

    doctor = commands.add_parser("doctor", help="inside: check everything a build needs, and change nothing")
    doctor.add_argument("--env", required=True, help="the inventory under inventories/, e.g. dev")

    build = commands.add_parser("build", help="inside: check, then build or update the environment's registry")
    build.add_argument("--env", required=True, help="the inventory under inventories/, e.g. dev")

    remove = commands.add_parser("remove", help="inside: take Harbor off the environment's server; its images stay")
    remove.add_argument("--env", required=True, help="the inventory under inventories/, e.g. dev")
    remove.add_argument("--keep-certificate", action="store_true", help="leave the registry's certificate on the server")
    remove.add_argument("--purge-data", action="store_true", help="also delete every image (asks you to type the "
                                                                  "environment's name)")

    load = commands.add_parser("load", help="inside, after python3 kit build: push the Broadcom bundles into Harbor")
    load.add_argument("--env", required=True, help="the inventory under inventories/, e.g. prod")
    load.add_argument("--from", dest="from_dir", metavar="DIR", help="default <staging>/broadcom")
    load.add_argument("--registry", help="Harbor's name; default harbor_hostname from the inventory")
    load.add_argument("--user", help="Harbor user; default admin, or HARBOR_USER. The password comes from "
                                     "HARBOR_PASSWORD or a prompt")
    load.add_argument("--ca", help="CA for Harbor's certificate; default the staged one (harbor_tls_staged_ca), "
                                   "or /etc/ipa/ca.crt")
    load.add_argument("--staging", help="default artifact_staging from the inventory")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        return 1
    handlers = {"choose": cmd_choose, "check": cmd_check, "fetch": cmd_fetch, "catalog": cmd_catalog,
                "verify": cmd_verify, "publish": cmd_publish, "setup": cmd_setup, "doctor": cmd_doctor,
                "build": cmd_build, "load": cmd_load, "remove": cmd_remove}
    # A repository with its own Ansible in .venv (the lab's bootstrap puts one there) uses it, as make does.
    venv = os.path.join(REPO, ".venv", "bin")
    if os.path.isfile(os.path.join(venv, "ansible-playbook")):
        os.environ["PATH"] = venv + os.pathsep + os.environ.get("PATH", "")
    try:
        handlers[args.command](args)
        return 0
    except KitError as error:
        print("", flush=True)
        log("ERROR: %s" % error)
        return error.code
    except KeyboardInterrupt:
        print("", flush=True)
        log("Stopped. Nothing half-written was kept.")
        return 130


if __name__ == "__main__":
    sys.exit(main())
