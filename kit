class Inventory(object):
    """The literal values the kit needs from inventories/<env>, read without Ansible or the vault."""

    def __init__(self, env):
        self.env = env
        self.dir = os.path.join(REPO, "inventories", env)
        hosts_file = os.path.join(self.dir, "hosts")
        if not os.path.isfile(hosts_file):
            root = os.path.join(REPO, "inventories")
            known = sorted(d for d in os.listdir(root) if os.path.isfile(os.path.join(root, d, "hosts")))
            die("there is no inventory %r; choose one of: %s" % (env, ", ".join(known)))
        self.hosts = self.group_hosts(hosts_file, "registry")
        files = sorted(glob.glob(os.path.join(self.dir, "group_vars", "all", "*.yml")))
        files += sorted(glob.glob(os.path.join(self.dir, "group_vars", "registry", "*.yml")))
        if self.hosts:
            files.append(os.path.join(self.dir, "host_vars", self.hosts[0] + ".yml"))
        self.files = [path for path in files if os.path.isfile(path)]
        self.vars = {}
        for path in files:
            if not os.path.isfile(path) or os.path.basename(path) == "vault.yml":
                continue
            with open(path, encoding="utf-8") as handle:
                text = handle.read()
            if text.lstrip().startswith("$ANSIBLE_VAULT"):
                continue
            try:
                data = parse_yaml(text, os.path.relpath(path, REPO))
            except KitError:
                continue
            if isinstance(data, dict):
                self.vars.update(data)

    @staticmethod
    def group_hosts(path, group):
        hosts, current = [], None
        with open(path) as handle:
            for line in handle:
                line = re.split(r"[#;]", line, maxsplit=1)[0].strip()
                if not line:
                    continue
                if line.startswith("[") and line.endswith("]"):
                    current = line[1:-1]
                elif current == group:
                    hosts.append(line.split()[0])
        return hosts

    def render(self, value, depth=0):
        if not isinstance(value, str) or "{{" not in value or depth > 5:
            return value

        def substitute(match):
            name = match.group(1).strip()
            if re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", name) and name in self.vars:
                return str(self.render(self.vars[name], depth + 1))
            return match.group(0)
        return re.sub(r"\{\{(.*?)\}\}", substitute, value)

    def literal(self, name, default=None):
        value = self.render(self.vars.get(name, default))
        if value is None or "{{" in str(value):
            return default
        return str(value)

    def where(self, name):
        for path in reversed(self.files):
            with open(path, encoding="utf-8", errors="replace") as handle:
                if re.search(r"^%s:" % re.escape(name), handle.read(), re.M):
                    return os.path.relpath(path, REPO)
        if name == "broadcom_items":
            return "inventories/%s/group_vars/registry/broadcom.yml" % self.env
        for rel in ("group_vars/all/artifacts.yml", "group_vars/all/main.yml", "group_vars/registry/main.yml"):
            path = os.path.join(self.dir, rel)
            if os.path.isfile(path):
                with open(path) as handle:
                    if re.search(r"^%s:" % re.escape(name), handle.read(), re.M):
                        return "inventories/%s/%s" % (self.env, rel)
        if self.hosts:
            return "inventories/%s/host_vars/%s.yml" % (self.env, self.hosts[0])
        return "inventories/%s" % self.env


def ensure_staging(path):
    if os.path.isdir(path) and os.access(path, os.W_OK):
        return
    if os.geteuid() == 0:
        os.makedirs(path, exist_ok=True)
        return
    user = getpass.getuser()
    log("%s is missing or not writable by %s; creating it with sudo" % (path, user))
    for cmd in (["sudo", "mkdir", "-p", path], ["sudo", "chown", "%s:" % user, path]):
        if run_interactive(cmd):
            die("could not prepare %s. Run: sudo mkdir -p %s && sudo chown %s: %s" % (path, path, user, path))


def kit_mismatches(harbor_dir, inv):
    """What the inventory expects to find in these Harbor files that isn't there."""
    runtime = inv.literal("harbor_container_runtime", "podman")
    provider = inv.literal("harbor_podman_compose_provider", "podman-compose")
    has_binary = os.path.isfile(os.path.join(harbor_dir, "docker-compose-linux-x86_64"))
    has_rpms = {sub: bool(glob.glob(os.path.join(harbor_dir, sub, "*.rpm"))) for sub in ("podman", "docker")}
    found = []
    if runtime == "podman" and provider == "docker-compose" and not has_binary:
        found.append("the inventory runs Harbor with docker-compose, but this transfer has no docker-compose binary. "
                     "Set harbor.compose_provider: docker-compose in kit.yml and fetch again, or set "
                     "harbor_podman_compose_provider: podman-compose in %s" % inv.where("harbor_podman_compose_provider"))
    elif runtime == "podman" and provider == "podman-compose" and not has_rpms["podman"]:
        found.append("the inventory runs Harbor with podman-compose, but this transfer has no podman-compose RPMs. "
                     "Set harbor.compose_provider: podman-compose in kit.yml and fetch again, or set "
                     "harbor_podman_compose_provider: docker-compose in %s" % inv.where("harbor_podman_compose_provider"))
    if runtime == "docker" and inv.literal("docker_offline_source", "yum") == "staged" and not has_rpms["docker"]:
        found.append("the inventory installs Docker CE from the transfer (docker_offline_source: staged), but this transfer "
                     "has no Docker RPMs. Set docker_ce.enabled: true in kit.yml and fetch again, or set "
                     "docker_offline_source: yum in %s if the server's repositories carry Docker CE"
                     % inv.where("docker_offline_source"))
    return found


def cmd_verify(args):
    root = os.path.abspath(os.path.expanduser(args.from_dir))
    step("Checking %s" % root)
    verify_dir(root)


def cmd_publish(args):
    root = os.path.abspath(os.path.expanduser(args.from_dir))
    step("Checking the transfer")
    sums = verify_dir(root)
    inv = Inventory(args.env)
    staging = os.path.abspath(args.staging or inv.literal("artifact_staging") or "/var/staging/artifacts")
    ensure_staging(staging)

    if os.path.isdir(os.path.join(root, "harbor")):
        for problem in kit_mismatches(os.path.join(root, "harbor"), inv):
            log("WARNING: " + problem)
        step("Staging the Harbor files in %s" % staging)
        os.environ["KIT_RUNNING"] = "1"
        code = run_interactive(["bash", os.path.join(REPO, "scripts", "pull_harbor.sh"),
                                "--from", os.path.join(root, "harbor"), "--to", staging, "--inventory", inv.dir])
        if code:
            die("staging the Harbor files failed (see above)", code)
        nexus_on = inv.vars.get("nexus_enabled")
        source = ("repo" if nexus_on else "staged") if isinstance(nexus_on, bool) else inv.literal("artifact_source", "staged")
        if source != "repo":
            log("Nexus is off for %s: the build reads the Harbor files from %s" % (args.env, staging))
        elif args.skip_nexus:
            log("--skip-nexus: not publishing to Nexus")
        else:
            nexus = (args.nexus or inv.literal("nexus_url") or "").rstrip("/")
            if not nexus or "CHANGE_ME" in nexus:
                die("set nexus_url in %s, or pass --nexus https://<nexus>" % inv.where("nexus_url"))
            step("Uploading the Harbor files to %s" % nexus)
            cmd = ["bash", os.path.join(REPO, "scripts", "publish_harbor.sh"), "--nexus", nexus,
                   "--dir", os.path.join(staging, "harbor"),
                   "--raw-repo", inv.literal("nexus_raw_repo", "vmware-raw"),
                   "--yum-repo", inv.literal("nexus_yum_repo", "harbor-epel")]
            if args.cacert:
                cmd += ["--cacert", args.cacert]
            code = run_interactive(cmd)
            if code:
                die("publishing to Nexus failed (see above)", code)

    if os.path.isdir(os.path.join(root, "broadcom")):
        dest = os.path.join(staging, "broadcom")
        step("Staging the Broadcom bundles in %s" % dest)
        set_aside(dest)
        copy_tree(os.path.join(root, "broadcom"), dest)
        if os.path.isfile(os.path.join(root, "tools", "imgpkg")):
            os.makedirs(os.path.join(dest, "tools"), exist_ok=True)
            shutil.copyfile(os.path.join(root, "tools", "imgpkg"), os.path.join(dest, "tools", "imgpkg"))
            os.chmod(os.path.join(dest, "tools", "imgpkg"), 0o755)
        checked = 0
        for rel, want in sums.items():
            top = rel.split(os.sep, 1)
            if top[0] in ("broadcom", "tools") and len(top) == 2:
                target = os.path.join(dest, top[1]) if top[0] == "broadcom" else os.path.join(dest, "tools", top[1])
                if sha256_file(target) != want:
                    die("%s changed while it was copied" % target, 2)
                checked += 1
        log("%d files staged and checked" % checked)

    step("Next")
    print("    make build-registry ENV=%s" % args.env)
    if os.path.isdir(os.path.join(root, "broadcom")):
        print("    python3 kit load --env %s" % args.env)


def cmd_load(args):
    inv = Inventory(args.env)
    staging = os.path.abspath(args.staging or inv.literal("artifact_staging") or "/var/staging/artifacts")
    bdir = os.path.abspath(os.path.expanduser(args.from_dir)) if args.from_dir else os.path.join(staging, "broadcom")
    manifest = os.path.join(bdir, "bundles.json")
    if not os.path.isfile(manifest):
        die("no Broadcom bundles at %s: run python3 kit publish first" % bdir)
    with open(manifest) as handle:
        bundles = json.load(handle)

    # What this environment turns on decides which catalog items go in. Bundles that came
    # from service YAMLs or kit.yml alone go into every environment.
    catalog = load_catalog(repo_path("broadcom/catalog.yml"))
    choices, problems = wanted_items(inv, catalog)
    if problems:
        for problem in problems:
            row("FAIL", problem)
        die("fix broadcom_items first")
    carried = {(b.get("item"), b.get("version")) for b in bundles if b.get("item")}
    absent = ["%s %s" % (key, v) for key, versions in choices.items() for v in versions if (key, v) not in carried]
    if absent:
        die("%s turns on %s, which this transfer doesn't carry. Turn the same on for %s on the connected "
            "side, run python3 kit fetch, and bring that transfer in" % (inv.where("broadcom_items"), ", ".join(absent), args.env))
    selected = [b for b in bundles if not b.get("item") or b.get("version") in choices.get(b["item"], [])]
    skipped = sorted({"%s %s" % (b["item"], b["version"]) for b in bundles if b not in selected})

    registry = args.registry or inv.literal("harbor_hostname")
    if not registry or "CHANGE_ME" in registry:
        die("set harbor_hostname in %s, or pass --registry <fqdn>" % inv.where("harbor_hostname"))
    projects = {"library"} | {catalog[key]["project"] for key in choices}
    for project in inv.vars.get("harbor_projects") or []:
        projects.add(project.get("name") if isinstance(project, dict) else str(project))
    missing = sorted({b["project"] for b in selected} - projects)
    if missing and not args.registry:
        die("Harbor project(s) %s are not in harbor_projects in %s: add them and run make build-registry first"
            % (", ".join(missing), inv.where("harbor_projects")))
    if not selected:
        log("Nothing in this transfer is for %s%s" % (args.env, " (it carries %s for other environments)" % ", ".join(skipped) if skipped else ""))
        return

    ca = args.ca
    if not ca:
        staged_ca = inv.literal("harbor_tls_staged_ca") or os.path.join(staging, "tls", "ca.crt")
        ca = next((c for c in (staged_ca, "/etc/ipa/ca.crt") if c and os.path.isfile(c)), None)
    imgpkg = shutil.which("imgpkg") or os.path.join(bdir, "tools", "imgpkg")
    if not os.path.isfile(imgpkg):
        die("imgpkg not found: it should be in %s/tools" % bdir)
    if os.access(imgpkg, os.W_OK):
        os.chmod(imgpkg, 0o755)
    user = args.user or os.environ.get("HARBOR_USER") or "admin"
    password = os.environ.get("HARBOR_PASSWORD") or getpass.getpass("Harbor password for %s on %s: " % (user, registry))
    env = dict(os.environ, IMGPKG_REGISTRY_HOSTNAME=registry, IMGPKG_REGISTRY_USERNAME=user,
               IMGPKG_REGISTRY_PASSWORD=password)

    step("Pushing %d bundle(s) into %s" % (len(selected), registry))
    for b in selected:
        repo = "%s/%s/%s" % (registry, b["project"], b["repo"])
        cmd = [imgpkg, "copy", "--tar", os.path.join(bdir, b["tar"]), "--to-repo", repo]
        if ca:
            cmd += ["--registry-ca-cert-path", ca]
        code, _ = run(cmd + imgpkg_extra_args(), env=env)
        if code:
            die("imgpkg could not push %s to %s (see above). If its project is new, run make build-registry ENV=%s first"
                % (b["tar"], repo, args.env), 2)
        b["target"] = repo + (":" + b["tag"] if b["tag"] else "@" + b["digest"])
        row("OK", "%s %s" % (b["item"], b["version"]) if b.get("item") else b["ref"], "-> " + b["target"])
    if skipped:
        log("Not for %s, so left in the transfer: %s" % (args.env, ", ".join(skipped)))

    relocated = {}
    services_dir = os.path.join(bdir, "services")
    if os.path.isdir(services_dir):
        out_dir = os.path.join(bdir, "relocated")
        os.makedirs(out_dir, exist_ok=True)
        step("Service YAMLs pointing at %s" % registry)
        for name in sorted(os.listdir(services_dir)):
            mine = [b for b in bundles if name in b.get("services", [])]
            if any("target" not in b for b in mine):
                row("--", name, "skipped: %s isn't turned on for %s" % (
                    ", ".join("%s %s" % (b["item"], b["version"]) for b in mine if "target" not in b), args.env))
                continue
            with open(os.path.join(services_dir, name), encoding="utf-8") as handle:
                text = handle.read()
            for b in mine:
                text = text.replace(b["ref"], b["target"])
                relocated[b["ref"]] = os.path.join(out_dir, name)
            with open(os.path.join(out_dir, name), "w", encoding="utf-8") as handle:
                handle.write(text)
            row("OK", os.path.join(out_dir, name))

    items = {}
    for b in selected:
        if b.get("item"):
            items.setdefault((b["item"], b["version"]), []).append(b)
    if items or relocated:
        step("Next")
    for (key, version), group in items.items():
        kind = group[0].get("item_kind") or catalog.get(key, {}).get("kind")
        first = group[0]
        if kind == "supervisor-service":
            detail = ("add %s in vCenter" % relocated[first["ref"]] if first["ref"] in relocated else
                      "add Broadcom's YAML for it in vCenter, with its image set to %s" % first["target"])
        elif kind == "addon-repository":
            detail = "point VKS at %s (imageURL in an AddonRepository on VKS 3.7 and later)" % first["target"]
        else:
            charts = [b for b in group if "/helm-charts/" in "/" + b["repo"]]
            detail = "images and charts in %s/%s" % (registry, first["project"])
            if charts:
                detail += "; helm install ... oci://%s --version %s, with the chart's image repositories set to %s/%s" % (
                    charts[0]["target"].rsplit(":", 1)[0], charts[0]["tag"], registry, first["project"])
        row("", "%s %s" % (key, version), detail, width=28)
    if relocated:
        log("Supervisor Services go in under Workload Management > Services > Add New Service")
        log("(or Add New Version for a service that is already registered).")
    step("Done")


def cmd_catalog(args):
    catalog = load_catalog(repo_path("broadcom/catalog.yml"))
    if not catalog:
        die("there is no broadcom/catalog.yml in %s" % REPO)
    envs = [args.env] if args.env else [name for name in inventory_names() if not name.startswith("_")]
    turned_on = {}
    for env in envs:
        choices, problems = wanted_items(Inventory(env), catalog)
        for problem in problems:
            row("FAIL", problem)
        for key, versions in choices.items():
            for version in versions:
                turned_on.setdefault(key, []).append("%s %s" % (env, version))
    step("broadcom/catalog.yml: what each environment can turn on in group_vars/registry/broadcom.yml")
    for key, item in catalog.items():
        versions = list(item["versions"])
        print("")
        row("", key, item.get("name", ""), width=28)
        row("", "", "versions %s (default %s); goes to Harbor project %s" % (
            ", ".join(versions[:6]) + (", ..." if len(versions) > 6 else ""), item["default"], item["project"]), width=28)
        if item.get("needs"):
            row("", "", "needs " + str(item["needs"]), width=28)
        row("", "", "on in: " + (", ".join(turned_on.get(key, [])) or "none of %s" % ", ".join(envs)), width=28)
    print("")


# --- entry point -------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(prog="python3 kit", description=__doc__.split("\n\n")[0],
                                     epilog="Run 'python3 kit <command> --help' for each command.")
    parser.add_argument("--config", default=os.path.join(REPO, "kit.yml"), help="default: kit.yml next to this tool")
    commands = parser.add_subparsers(dest="command", metavar="command")

    commands.add_parser("check", help="check kit.yml, the tools, and that every source can be reached")
    commands.add_parser("fetch", help="download and verify everything into one transfer folder")
    catalog = commands.add_parser("catalog", help="what broadcom/catalog.yml offers and what each environment turns on")
    catalog.add_argument("--env", help="only this inventory")

    verify = commands.add_parser("verify", help="check a transfer against its SHA256SUMS")
    verify.add_argument("--from", dest="from_dir", required=True, metavar="DIR", help="the transfer folder")

    publish = commands.add_parser("publish", help="inside: verify, stage, and upload the Harbor files to Nexus")
    publish.add_argument("--from", dest="from_dir", required=True, metavar="DIR", help="the transfer folder")
    publish.add_argument("--env", required=True, help="the inventory under inventories/, e.g. prod")
    publish.add_argument("--nexus", help="Nexus URL, when the inventory has nexus_enabled: true; default nexus_url")
    publish.add_argument("--cacert", help="CA bundle for Nexus's certificate, e.g. /etc/ipa/ca.crt")
    publish.add_argument("--staging", help="default artifact_staging from the inventory")
    publish.add_argument("--skip-nexus", action="store_true", help="stage only; publish later")

    load = commands.add_parser("load", help="inside, after make build-registry: push the Broadcom bundles into Harbor")
    load.add_argument("--env", required=True, help="the inventory under inventories/, e.g. prod")
    load.add_argument("--from", dest="from_dir", metavar="DIR", help="default <staging>/broadcom")
    load.add_argument("--registry", help="Harbor's name; default harbor_hostname from the inventory")
    load.add_argument("--user", help="Harbor user; default admin, or HARBOR_USER. The password comes from "
                                     "HARBOR_PASSWORD or a prompt")
    load.add_argument("--ca", help="CA for Harbor's certificate; default the staged one (harbor_tls_staged_ca), "
                                   "or /etc/ipa/ca.crt")
    load.add_argument("--staging", help="default artifact_staging from the inventory")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        return 1
    handlers = {"check": cmd_check, "fetch": cmd_fetch, "catalog": cmd_catalog, "verify": cmd_verify,
                "publish": cmd_publish, "load": cmd_load}
    try:
        handlers[args.command](args)
        return 0
    except KitError as error:
        print("", flush=True)
        log("ERROR: %s" % error)
        return error.code
    except KeyboardInterrupt:
        print("", flush=True)
        log("Stopped. Nothing half-written was kept.")
        return 130


if __name__ == "__main__":
    sys.exit(main())
