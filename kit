ANSIBLE_MIN = (2, 14)
PLACEHOLDER = re.compile(r"CHANGE_ME|REPLACE")


def this_machine():
    """Every name and address this machine answers to, in lower case."""
    names = {"localhost", "127.0.0.1", "::1", socket.gethostname(), socket.getfqdn()}
    try:
        names |= set(socket.gethostbyname_ex(socket.gethostname())[2])
    except OSError:
        pass
    try:
        names |= set(subprocess.run(["hostname", "-I"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                    universal_newlines=True).stdout.split())
    except OSError:
        pass
    return {name.lower() for name in names if name}


def quiet(cmd, timeout=30):
    """Run a command without showing it: (exit code, stdout and stderr together)."""
    try:
        proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, universal_newlines=True,
                              timeout=timeout)
        return proc.returncode, proc.stdout
    except (OSError, subprocess.TimeoutExpired) as error:
        return 127, str(error)


def is_hostname(text):
    return bool(re.match(r"^(?=.{1,253}$)([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$", text))


def is_address(text):
    try:
        socket.inet_pton(socket.AF_INET6 if ":" in text else socket.AF_INET, text)
        return True
    except (OSError, ValueError):
        return False


def resolves(name):
    try:
        socket.getaddrinfo(name, None)
        return True
    except OSError:
        return False


def yaml_scalar(value):
    """A value as YAML would read it back unchanged: plain when that's safe, quoted otherwise."""
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, list):
        return "[%s]" % ", ".join(yaml_scalar(str(v)) for v in value)
    text = str(value)
    if (re.match(r"^[A-Za-z][A-Za-z0-9_./@-]*$", text) or re.match(r"^/[A-Za-z0-9_./-]*$", text)) and \
            text.lower() not in ("true", "false", "yes", "no", "on", "off", "null", "y", "n"):
        return text
    return '"%s"' % text.replace("\\", "\\\\").replace('"', '\\"')


class InventoryEdit(object):
    """Changes to an inventory's files, made in memory and saved together. Each setting keeps its
    line, spacing and comment; a commented-out line for it is used before anything is appended."""

    def __init__(self, inv):
        self.inv = inv
        self.files = {}
        self.changed = []           # (file, setting, before, after)

    def _lines(self, rel):
        if rel not in self.files:
            path = os.path.join(self.inv.dir, rel)
            with open(path, encoding="utf-8") as handle:
                self.files[rel] = handle.read().splitlines(True)
        return self.files[rel]

    def set(self, rel, name, value):
        lines = self._lines(rel)
        text = yaml_scalar(value)
        rx = re.compile(r"^(#\s*)?(%s:)([ \t]*)([^#\n]*?)([ \t]*#.*)?$" % re.escape(name))
        active = commented = None
        for i, line in enumerate(lines):
            match = rx.match(line.rstrip("\n"))
            if match and not match.group(1) and active is None:
                active = (i, match)
            elif match and match.group(1) and commented is None:
                commented = (i, match)
        i, match = active or commented or (None, None)
        if match is None:
            if lines and not lines[-1].endswith("\n"):
                lines[-1] += "\n"
            lines.append("%s: %s\n" % (name, text))
            before = None
        else:
            before = None if match.group(1) else match.group(4).strip()
            if before == text:
                return
            lines[i] = "%s%s%s%s\n" % (match.group(2), match.group(3) or " ", text, match.group(5) or "")
        self.changed.append((rel, name, before, text))

    def unset(self, rel, name):
        """Comment a setting out, so its line and its explanation stay in the file."""
        lines = self._lines(rel)
        for i, line in enumerate(lines):
            if re.match(r"^%s:" % re.escape(name), line):
                lines[i] = "# " + line
                self.changed.append((rel, name, line.split(":", 1)[1].split("#")[0].strip(), None))
                return

    def item(self, rel, key, value):
        """One entry under broadcom_items:, set to false, a version, or a list of versions."""
        lines = self._lines(rel)
        text = yaml_scalar(value)
        start = next((i for i, line in enumerate(lines) if re.match(r"^broadcom_items:", line)), None)
        if start is None:
            lines.append("broadcom_items:\n")
            start = len(lines) - 1
        end = next((i for i in range(start + 1, len(lines)) if re.match(r"^[^\s#]", lines[i])), len(lines))
        for i in range(start + 1, end):
            match = re.match(r"^(\s+%s:)([ \t]*)([^#\n]*?)([ \t]*#.*)?$" % re.escape(key), lines[i].rstrip("\n"))
            if match:
                before = match.group(3).strip()
                if before != text:
                    lines[i] = "%s%s%s%s\n" % (match.group(1), match.group(2) or " ", text, match.group(4) or "")
                    self.changed.append((rel, "broadcom_items." + key, before, text))
                return
        last = max(i for i in range(start, end) if lines[i].strip()) + 1
        lines.insert(last, "  %s: %s\n" % (key, text))
        self.changed.append((rel, "broadcom_items." + key, None, text))

    def rename_host(self, old, new):
        lines = self._lines("hosts")
        group = None
        for i, line in enumerate(lines):
            stripped = re.split(r"[#;]", line, maxsplit=1)[0].strip()
            if stripped.startswith("[") and stripped.endswith("]"):
                group = stripped[1:-1]
            elif group == "registry" and stripped.split() and stripped.split()[0] == old:
                lines[i] = line.replace(old, new, 1)
                self.changed.append(("hosts", "[registry]", old, new))
                return

    def save(self):
        for rel, lines in self.files.items():
            path = os.path.join(self.inv.dir, rel)
            tmp = path + ".new"
            with open(tmp, "w", encoding="utf-8") as handle:
                handle.write("".join(lines))
            os.replace(tmp, path)


def ask_value(question, default="", check=None):
    """A line of text at the terminal. Enter takes the default; check returns a problem or None."""
    while True:
        try:
            answer = input("    %s%s: " % (question, " [%s]" % default if default else "")).strip()
        except EOFError:
            print("")
            die("stopped: no answer")
        answer = answer or default
        problem = check(answer) if check else (None if answer else "an answer is needed")
        if not problem:
            return answer
        print("      %s" % problem)


def ask_secret(question, check=None, generate=False):
    while True:
        try:
            first = getpass.getpass("    %s%s: " % (question, " (Enter to generate one)" if generate else ""))
            again = None
        except EOFError:
            print("")
            die("stopped: no answer")
        if not first and generate:
            alphabet = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789"
            return "".join(alphabet[b % len(alphabet)] for b in os.urandom(24)) + "A7a"
        problem = check(first) if check else None
        if problem:
            print("      %s" % problem)
            continue
        try:
            again = getpass.getpass("    The same again: ")
        except EOFError:
            print("")
            die("stopped: no answer")
        if again == first:
            return first
        print("      They didn't match.")


def harbor_password_problem(text):
    if len(text) < 8 or not re.search(r"[A-Z]", text) or not re.search(r"[a-z]", text) or not re.search(r"[0-9]", text):
        return "Harbor needs 8 or more characters, with an upper-case letter, a lower-case letter and a number."
    return None


def cert_problems(cert, key, ca, name):
    """What's wrong with a certificate, its key and its CA for this registry name: (problems, notes)."""
    problems, notes = [], []
    if not shutil.which("openssl"):
        return problems, ["openssl isn't installed here, so the certificate wasn't checked"]
    code, text = quiet(["openssl", "x509", "-in", cert, "-noout", "-text"])
    if code:
        return ["%s isn't a PEM certificate" % cert], notes
    san = re.search(r"X509v3 Subject Alternative Name:[^\n]*\n\s*([^\n]+)", text)
    sans = re.findall(r"DNS:([^,\s]+)", san.group(1)) if san else []
    if re.search(r"CA:TRUE", text):
        problems.append("it's a CA's certificate, not the registry's")
    elif not any(n.lower() == name.lower() or (n.startswith("*.") and name.lower().endswith(n[1:].lower())
                                               and name.count(".") == n.count(".")) for n in sans):
        problems.append("it's for %s, not %s" % (", ".join(sans), name) if sans else
                        "it has no DNS name in its Subject Alternative Name, which the Supervisor and VKS need")
    if quiet(["openssl", "x509", "-in", cert, "-noout", "-checkend", "0"])[0]:
        problems.append("it has expired")
    elif quiet(["openssl", "x509", "-in", cert, "-noout", "-checkend", str(30 * 86400)])[0]:
        notes.append("it expires within 30 days")
    if key:
        mine = quiet(["openssl", "x509", "-in", cert, "-noout", "-pubkey"])
        theirs = quiet(["openssl", "pkey", "-in", key, "-pubout"])
        if theirs[0]:
            problems.append("%s isn't a private key openssl can read (is it encrypted?)" % key)
        elif mine[1].strip() != theirs[1].strip():
            problems.append("%s isn't the key for this certificate" % key)
    if ca and quiet(["openssl", "verify", "-CAfile", ca, cert])[0]:
        problems.append("%s didn't issue it (openssl verify fails)" % ca)
    return problems, notes


def staged_tls(inv, staging, name):
    """Where the build reads the staged certificate, key and CA: harbor_tls_staged_cert, _key and _ca,
    which default to <artifact_staging>/tls/. The CA is "" when the server already trusts it."""
    return [inv.literal("harbor_tls_staged_cert") or os.path.join(staging, "tls", name + ".crt"),
            inv.literal("harbor_tls_staged_key") or os.path.join(staging, "tls", name + ".key"),
            inv.literal("harbor_tls_staged_ca", os.path.join(staging, "tls", "ca.crt"))]


def vault_state(inv):
    path = os.path.join(inv.dir, "group_vars", "all", "vault.yml")
    if not os.path.isfile(path):
        return path, None
    with open(path, encoding="utf-8", errors="replace") as handle:
        return path, handle.read().lstrip().startswith("$ANSIBLE_VAULT")


def vault_args(inv):
    path, encrypted = vault_state(inv)
    if os.path.isfile(os.path.join(REPO, ".vault_pass")):
        return ["--vault-password-file", os.path.join(REPO, ".vault_pass")]
    return ["--ask-vault-pass"] if encrypted else []


def show_changes(edit):
    for rel, setting, before, after in edit.changed:
        row("", "%s: %s" % (rel, setting), "%s -> %s" % (before if before is not None else "(not set)",
                                                        after if after is not None else "(commented out)"), width=50)


def not_carried(inv, catalog, bdir):
    """The items and versions an environment turns on that the transfer staged in bdir doesn't carry;
    None when no transfer is staged there."""
    manifest = os.path.join(bdir, "bundles.json")
    if not os.path.isfile(manifest):
        return None
    with open(manifest) as handle:
        carried = {(b.get("item"), b.get("version")) for b in json.load(handle) if b.get("item")}
    choices, _ = wanted_items(inv, catalog)
    return ["%s %s" % (key, v) for key, versions in choices.items() for v in versions if (key, v) not in carried]


