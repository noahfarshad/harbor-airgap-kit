# inventories/<env>/hosts
#
# One environment. Copy this directory to inventories/<env> and replace every
# CHANGE_ME.
#
# One group per kind of server; each group's settings live in group_vars/<group>/
# and each server's in host_vars/<host>.yml. registry01 is only a label for the
# registry in this inventory, not the server's name: Ansible connects to
# registry_server_fqdn from host_vars/registry01.yml. Rename the label and that
# file together. When Harbor goes on the machine you run Ansible from, set
# ansible_connection: local in that file.

[registry]
registry01

[linux:children]
registry
