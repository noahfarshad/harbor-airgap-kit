# {{ ansible_managed }}
[Unit]
Description=Harbor container registry ({{ harbor_container_runtime }})
{% if harbor_container_runtime == 'docker' %}
Requires=docker.service
After=docker.service network-online.target
{% elif harbor_podman_compose_provider == 'docker-compose' %}
Requires=podman.socket
After=podman.socket network-online.target
{% else %}
After=network-online.target
{% endif %}
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ harbor_install_dir }}
{% if harbor_container_runtime == 'docker' %}
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
{% else %}
{% if harbor_podman_compose_provider == 'docker-compose' %}
Environment=DOCKER_HOST=unix://{{ harbor_podman_socket }}
{% endif %}
ExecStart={{ harbor_podman_compose_bin }} -p {{ harbor_compose_project }} -f podman-compose.yml up -d
ExecStop={{ harbor_podman_compose_bin }} -p {{ harbor_compose_project }} -f podman-compose.yml down
{% endif %}
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
