def choose_items(inv, edit, catalog):
    """Ask which catalog items an environment gets, and at which versions; the answers go into edit."""
    raw = inv.vars.get("broadcom_items") if isinstance(inv.vars.get("broadcom_items"), dict) else {}
    print("")
    print("    Broadcom content for this environment:")
    keys = list(catalog)
    on = []
    for n, key in enumerate(keys, 1):
        value = raw.get(key)
        now = (", ".join(pinned(value)) if pinned(value) else catalog[key]["default"] if value is True else "")
        if now:
            on.append(str(n))
        print("      %2d  %-30s %s" % (n, key, "on: " + now if now else ""))

    def numbers_problem(text):
        if text == "none":
            return None
        bad = [t for t in text.replace(",", " ").split() if not t.isdigit() or not 1 <= int(t) <= len(keys)]
        return "numbers from the list, separated by spaces, or none" if bad else None
    picked = ask_value("Which should it have? Numbers separated by spaces, or none", " ".join(on) or "none",
                       numbers_problem)
    chosen = [] if picked == "none" else [keys[int(t) - 1] for t in picked.replace(",", " ").split()]
    rel_items = os.path.relpath(os.path.join(REPO, inv.where("broadcom_items")), inv.dir)
    for key in keys:
        if key not in chosen:
            if raw.get(key) not in (None, False):
                edit.item(rel_items, key, False)
            continue
        versions = list(catalog[key]["versions"])
        current = "default" if raw.get(key) is True else " ".join(pinned(raw.get(key)) or [catalog[key]["default"]])

        def version_problem(text, versions=versions):
            if text == "default":
                return None
            missing = [v for v in text.replace(",", " ").split() if v not in versions]
            return ("not in the catalog: %s (it has %s)" % (", ".join(missing), ", ".join(versions[:8])
                    + (", ..." if len(versions) > 8 else ""))) if missing else None
        answer = ask_value("%s version (newest %s; default follows the catalog)" % (key, versions[0]),
                           current, version_problem).replace(",", " ").split()
        edit.item(rel_items, key, True if answer == ["default"] else answer[0] if len(answer) == 1 else answer)


def change_vault(path, nexus):
    """What changed in an existing vault: (every value it holds, with the changes, or None when nothing
    changed; the password file that opened it, so the new one is encrypted with the same password)."""
    if not shutil.which("ansible-vault"):
        die("ansible-vault isn't installed. Install ansible-core %d.%d or later: sudo dnf install ansible-core"
            % ANSIBLE_MIN)
    pw_file = os.path.join(REPO, ".vault_pass")
    if not os.path.isfile(pw_file):
        temp_dir = tempfile.mkdtemp(prefix="kit-vault-")
        atexit.register(shutil.rmtree, temp_dir, True)
        pw_file = os.path.join(temp_dir, "password")
        try:
            secret = getpass.getpass("    The vault's password: ")
        except EOFError:
            print("")
            die("stopped: no answer")
        with os.fdopen(os.open(pw_file, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w") as handle:
            handle.write(secret + "\n")
    opened = subprocess.run(["ansible-vault", "view", "--vault-password-file", pw_file, path], cwd=REPO,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True)
    if opened.returncode:
        die("ansible-vault couldn't open the vault with that password, so nothing was changed")
    try:
        before = parse_yaml(opened.stdout, "vault.yml")
    except KitError:
        before = None
    if not isinstance(before, dict):
        die("the vault opened, but it isn't a list of passwords, so nothing was changed")
    before = dict((k, "" if v is None else str(v)) for k, v in before.items())
    values = dict(before)
    print("    Harbor's database password stays: its database keeps the one Harbor was built with.")
    if ask("Has Harbor's admin password been changed in the Harbor portal?", False):
        values["vault_harbor_admin_password"] = ask_secret("The new one, exactly as in the portal",
                                                           harbor_password_problem)
    if nexus:
        user = values.get("vault_repo_username", "")
        if ask("Does Nexus need a login to read the Harbor files?", bool(user)):
            values["vault_repo_username"] = ask_value("Nexus account", user)
            if values["vault_repo_username"] != user or not values.get("vault_repo_password") \
                    or not ask("Keep its password?", True):
                values["vault_repo_password"] = ask_secret("Its password", lambda t: None if t else "it can't be empty")
        else:
            values["vault_repo_username"] = values["vault_repo_password"] = ""
    return (values if values != before else None), pw_file


def cmd_setup(args):
    if not interactive():
        die("python3 kit setup asks questions, so it needs a terminal")
    new_dir = os.path.join(REPO, "inventories", args.env)
    if not os.path.isfile(os.path.join(new_dir, "hosts")):
        template = os.path.join(REPO, "inventories", "_template")
        if not re.match(r"^[a-z0-9][a-z0-9._-]*$", args.env):
            die("%r can't be an environment's name: use lowercase letters, digits, dots, dashes and underscores" % args.env)
        if os.path.exists(new_dir) or not os.path.isfile(os.path.join(template, "hosts")):
            Inventory(args.env)         # says which inventories there are
        if not ask("There's no inventories/%s yet. Start it from inventories/_template?" % args.env, True):
            die("nothing was created")
        shutil.copytree(template, new_dir, ignore=shutil.ignore_patterns("vault.yml", "*.previous"))
        row("OK", "inventories/%s, from the template" % args.env)
    inv = Inventory(args.env)
    rel_dir = os.path.relpath(inv.dir, REPO)
    edit = InventoryEdit(inv)
    step("Setting up %s. Enter keeps what's in brackets." % rel_dir)

    # The name under [registry] is only a label; its settings live in host_vars/<label>.yml.
    if len(inv.hosts) != 1:
        die("%s/hosts should list one server under [registry]; it lists %d" % (rel_dir, len(inv.hosts)))
    label = inv.hosts[0]
    hv_dir = os.path.join(inv.dir, "host_vars")
    if not os.path.isfile(os.path.join(hv_dir, label + ".yml")):
        others = sorted(f[:-4] for f in os.listdir(hv_dir) if f.endswith(".yml")) if os.path.isdir(hv_dir) else []
        if len(others) == 1 and ask("hosts calls the registry %s, but its settings are in host_vars/%s.yml. Call it %s "
                                    "in hosts, so they apply?" % (label, others[0], others[0]), True):
            edit.rename_host(label, others[0])
            edit.save()
            row("OK", "hosts now calls the registry %s" % others[0])
            inv = Inventory(args.env)
            edit = InventoryEdit(inv)
            label = others[0]
        else:
            template = os.path.join(REPO, "inventories", "_template", "host_vars", "registry01.yml")
            if not os.path.isfile(template):
                die("there's no host_vars/%s.yml in %s and no template to start it from" % (label, rel_dir))
            os.makedirs(hv_dir, exist_ok=True)
            shutil.copyfile(template, os.path.join(hv_dir, label + ".yml"))
            inv = Inventory(args.env)
            edit = InventoryEdit(inv)
    hv = "host_vars/%s.yml" % label

    print("")
    me = socket.getfqdn()
    if me.startswith("localhost"):
        me = socket.gethostname()
    machine = this_machine()
    fqdn = inv.literal("registry_server_fqdn", "")
    known = fqdn if fqdn and not PLACEHOLDER.search(fqdn) else ""
    here = ask("Does Harbor run on this machine (%s), the one you run kit from?" % me,
               str(inv.vars.get("ansible_connection", "")) == "local" or (known.lower() in machine if known else False))
    if here:
        edit.set(hv, "registry_server_fqdn", known if known.lower() in machine else me)
        edit.set(hv, "ansible_connection", "local")
    else:
        def server_problem(text):
            if PLACEHOLDER.search(text) or not (is_hostname(text) or is_address(text)):
                return "a server name like registry01.example.com, or its address"
            if text.lower() in machine:
                return "that's this machine; answer yes to the question before instead"
            return None
        server = ask_value("The registry server's name", known if known.lower() not in machine else "", server_problem)
        while not resolves(server) and not ask("%s doesn't resolve from here. Use it anyway?" % server, False):
            server = ask_value("The registry server's name", "", server_problem)
        edit.set(hv, "registry_server_fqdn", server)
        edit.unset(hv, "ansible_connection")
        user = ask_value("The account Ansible logs in with", inv.literal("ansible_user") or getpass.getuser(),
                         lambda t: None if re.match(r"^[a-z_][a-z0-9_.-]*\$?$", t) else "a Linux account name")
        if user != getpass.getuser() or inv.vars.get("ansible_user"):
            edit.set(hv, "ansible_user", user)

    name_now = inv.literal("harbor_hostname", "")
    name = ask_value("The registry's DNS name, the one the Supervisor and VKS use",
                     name_now if name_now and not PLACEHOLDER.search(name_now) else "",
                     lambda t: None if is_hostname(t) and "." in t and not PLACEHOLDER.search(t)
                     else "a DNS name like registry.example.com")
    if not resolves(name):
        print("      %s doesn't resolve yet. Give it a DNS record before the Supervisor uses it." % name)
    edit.set(hv, "harbor_hostname", name)

    volume = ask_value("Where Harbor keeps its images", inv.literal("harbor_data_volume", "/data"),
                       lambda t: None if t.startswith("/") and " " not in t else "an absolute path like /data")
    edit.set(hv, "harbor_data_volume", volume)
    edit.set("group_vars/registry/main.yml", "harbor_data_require_mount",
             ask("Stop the build unless %s is its own disk?" % volume,
                 str(inv.vars.get("harbor_data_require_mount", False)).lower() == "true"))

    print("")
    mode = inv.literal("harbor_tls_mode", "staged")
    ipa = ask("Does IdM issue the registry's certificate? (No: you have a certificate, key and CA from any CA)",
              mode == "ipa")
    edit.set("group_vars/registry/main.yml", "harbor_tls_mode", "ipa" if ipa else "staged")
    staging = inv.literal("artifact_staging", "/var/staging/artifacts")
    staged = staged_tls(inv, staging, name)
    tls = os.path.dirname(staged[0])
    cert_files = None
    if ipa:
        if here and not os.path.isfile("/etc/ipa/default.conf"):
            print("      This machine isn't an IdM client, so IdM can't issue it here. Answer no instead.")
    elif all(os.path.isfile(p) for p in staged if p) and not cert_problems(staged[0], staged[1], staged[2], name)[0] \
            and ask("A certificate for %s is already staged in %s. Keep it?" % (name, tls), True):
        pass
    else:
        def file_problem(text):
            return None if text == "skip" or os.path.isfile(os.path.expanduser(text)) else "no such file (or type skip)"
        cert = os.path.expanduser(ask_value("The certificate file for %s (PEM; skip to do it later)" % name, "", file_problem))
        if cert != "skip":
            key = os.path.expanduser(ask_value("Its private key file", "", file_problem))
            ca = os.path.expanduser(ask_value("The CA certificate that issued it", "", file_problem))
            problems, notes = cert_problems(cert, key, ca, name)
            for line in problems + notes:
                print("      %s" % line)
            if not problems or ask("Stage it anyway?", False):
                cert_files = (cert, key, ca)

    print("")
    nexus = ask("Keep the Harbor files in a Nexus as well? Most environments don't.",
                inv.vars.get("nexus_enabled") is True)
    edit.set("group_vars/all/artifacts.yml", "nexus_enabled", nexus)
    if nexus:
        url = inv.literal("nexus_url", "")
        edit.set("group_vars/all/artifacts.yml", "nexus_url",
                 ask_value("The Nexus URL", url if url and not PLACEHOLDER.search(url) else "",
                           lambda t: None if re.match(r"^https?://[^\s/]+", t) and not PLACEHOLDER.search(t)
                           else "a URL like https://nexus.example.com"))

    catalog = load_catalog(repo_path("broadcom/catalog.yml"))
    if catalog:
        choose_items(inv, edit, catalog)

    # The compose provider follows what the staged transfer carries; there's nothing to ask.
    harbor_dir = os.path.join(staging, "harbor")
    if inv.literal("harbor_container_runtime", "podman") == "podman" and os.path.isdir(harbor_dir):
        has_binary = os.path.isfile(os.path.join(harbor_dir, "docker-compose-linux-x86_64"))
        has_rpms = bool(glob.glob(os.path.join(harbor_dir, "podman", "*.rpm")))
        carried = "docker-compose" if has_binary and not has_rpms else "podman-compose" if has_rpms and not has_binary else None
        if carried and carried != inv.literal("harbor_podman_compose_provider", "podman-compose"):
            rel = os.path.relpath(os.path.join(REPO, inv.where("harbor_podman_compose_provider")), inv.dir)
            edit.set(rel, "harbor_podman_compose_provider", carried)
            print("")
            print("    The staged transfer carries %s, so Harbor will run with it." % carried)

    print("")
    vault, encrypted = vault_state(inv)
    vault_secrets, vault_pw_file = None, None
    if encrypted:
        if not ask("The vault is there and encrypted. Keep its passwords as they are?", True):
            vault_secrets, vault_pw_file = change_vault(vault, nexus)
    else:
        if encrypted is False:
            print("    group_vars/all/vault.yml is there but not encrypted. Setup replaces it with an encrypted one.")
        vault_secrets = {
            "vault_harbor_admin_password": ask_secret("Harbor's admin password", harbor_password_problem),
            "vault_harbor_db_password": ask_secret("Harbor's database password", harbor_password_problem, generate=True),
            "vault_repo_username": "", "vault_repo_password": ""}
        if nexus and ask("Does Nexus need a login to read the Harbor files?", False):
            vault_secrets["vault_repo_username"] = ask_value("Nexus account")
            vault_secrets["vault_repo_password"] = ask_secret("Its password", lambda t: None if t else "it can't be empty")

    step("Changes")
    if not edit.changed and not cert_files and not vault_secrets:
        row("OK", "nothing to change")
    show_changes(edit)
    if cert_files:
        row("", "certificate, key and CA", "-> %s" % tls, width=50)
    if vault_secrets:
        row("", "group_vars/all/vault.yml", "updated, same vault password" if vault_pw_file
            else "created and encrypted", width=50)
    if (edit.changed or cert_files or vault_secrets) and not ask("Save these?", True):
        die("nothing was saved")
    edit.save()

    if cert_files:
        ensure_staging(staging)
        for src, dest, mode_bits in zip(cert_files, staged, (0o644, 0o600, 0o644)):
            if not dest:
                continue
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            shutil.copyfile(src, dest)
            os.chmod(dest, mode_bits)
        row("OK", "staged the certificate in %s" % tls)
    if vault_secrets:
        if not shutil.which("ansible-vault"):
            die("ansible-vault isn't installed. Install ansible-core 2.14 or later (sudo dnf install ansible-core), "
                "then run python3 kit setup --env %s again" % args.env)
        tmp = vault + ".new"
        old_umask = os.umask(0o077)
        try:
            with open(tmp, "w", encoding="utf-8") as handle:
                handle.write("---\n# Harbor's passwords for %s, written by python3 kit setup.\n" % args.env)
                for key, value in vault_secrets.items():
                    handle.write("%s: %s\n" % (key, yaml_scalar(value) if value else '""'))
        finally:
            os.umask(old_umask)
        pw_file = vault_pw_file or (os.path.join(REPO, ".vault_pass")
                                    if os.path.isfile(os.path.join(REPO, ".vault_pass")) else None)
        cmd = ["ansible-vault", "encrypt", tmp] + (["--vault-password-file", pw_file] if pw_file else [])
        if not pw_file:
            print("    Choose the vault password. Keep it somewhere safe: every build asks for it.")
        if subprocess.call(cmd) != 0:
            os.remove(tmp)
            die("the vault wasn't encrypted, so it wasn't saved. Run python3 kit setup --env %s again" % args.env)
        os.replace(tmp, vault)
        row("OK", "%s/group_vars/all/vault.yml, encrypted" % rel_dir)

    if catalog:
        absent = not_carried(Inventory(args.env), catalog, os.path.join(staging, "broadcom"))
        if absent:
            row("WARN", "the staged transfer doesn't carry %s" % ", ".join(absent))
            print("          Choose it on the connected workstation (python3 kit choose --env %s), fetch, and bring "
                  "that transfer in. kit load stops until then." % args.env)
    problems, _ = preflight_env(args.env, "build")
    step("Next")
    if problems:
        print("    Fix what's above, then: python3 kit build --env %s" % args.env)
    else:
        print("    python3 kit build --env %s" % args.env)


class Checks(object):
    def __init__(self):
        self.problems = 0

    def ok(self, label, detail=""):
        row("OK", label, detail)

    def warn(self, label, detail=""):
        row("WARN", label, detail)

    def fail(self, label, fix):
        row("FAIL", label)
        print("          %s" % fix)
        self.problems += 1


def preflight_env(env, purpose):
    """Everything that would stop a playbook, checked before it starts: (problems, extra arguments)."""
    checks = Checks()
    inv = Inventory(env)
    setup = "python3 kit setup --env %s" % env
    step("Checking %s before the %s" % (os.path.relpath(inv.dir, REPO), purpose))

    apb = shutil.which("ansible-playbook")
    if not apb:
        checks.fail("ansible-playbook isn't installed", "Install ansible-core %d.%d or later: sudo dnf install ansible-core" % ANSIBLE_MIN)
    else:
        found = re.search(r"core (\d+)\.(\d+)", quiet([apb, "--version"])[1])
        have = tuple(int(n) for n in found.groups()) if found else ()
        if have and have < ANSIBLE_MIN:
            checks.fail("ansible-core %d.%d is too old" % have, "Install %d.%d or later" % ANSIBLE_MIN)
        else:
            checks.ok("ansible-core %s" % ".".join(str(n) for n in have) if have else "ansible-playbook", apb)

    if not inv.hosts:
        checks.fail("hosts has no server under [registry]", setup)
        return checks.problems, []
    label = inv.hosts[0]
    hv_dir = os.path.join(inv.dir, "host_vars")
    if not os.path.isfile(os.path.join(hv_dir, label + ".yml")):
        others = sorted(f[:-4] for f in os.listdir(hv_dir) if f.endswith(".yml")) if os.path.isdir(hv_dir) else []
        checks.fail("hosts calls the registry %s, but there's no host_vars/%s.yml%s" % (
            label, label, " (the settings are in host_vars/%s.yml)" % others[0] if others else ""),
            "%s fixes it" % setup)
        return checks.problems, []
    for name in ("registry_server_fqdn", "harbor_hostname"):
        value = inv.literal(name, "")
        if not value or PLACEHOLDER.search(value):
            checks.fail("%s isn't set" % name, setup)
    if checks.problems:
        return checks.problems, []

    target = (inv.literal("ansible_host") or inv.literal("registry_server_fqdn") or label).lower()
    local = str(inv.vars.get("ansible_connection", "")) == "local"
    mine = target in this_machine()
    extra = []
    if mine and not local:
        checks.fail("%s is this machine, but Ansible would log in to it over SSH" % target,
                    "%s, and answer yes to running Harbor on this machine" % setup)
    elif local and not mine:
        checks.fail("ansible_connection is local, but %s isn't this machine" % target,
                    "%s, and answer no to running Harbor on this machine" % setup)
    elif local:
        if os.geteuid() != 0 and quiet(["sudo", "-n", "true"])[0]:
            checks.warn("Harbor goes on this machine; sudo asks for a password", "you'll be asked for it once")
            extra.append("--ask-become-pass")
        else:
            checks.ok("Harbor goes on this machine", "sudo works")
    else:
        user = inv.literal("ansible_user") or getpass.getuser()
        ssh = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "%s@%s" % (user, target)]
        code, out = quiet(ssh + ["true"], timeout=30)
        if code and "Host key verification failed" in out:
            checks.fail("%s's SSH host key isn't known here yet" % target,
                        "Run ssh %s@%s once, check the fingerprint, and answer yes" % (user, target))
        elif code:
            checks.fail("can't log in to %s as %s without a password" % (target, user),
                        "Set up a key once: ssh-copy-id %s@%s" % (user, target))
        elif quiet(ssh + ["sudo", "-n", "true"], timeout=30)[0]:
            checks.warn("logs in to %s as %s; sudo there asks for a password" % (target, user), "you'll be asked for it once")
            extra.append("--ask-become-pass")
        else:
            checks.ok("logs in to %s as %s" % (target, user), "sudo works")

    vault, encrypted = vault_state(inv)
    if encrypted is None:
        checks.fail("there's no vault with Harbor's passwords", "%s creates it" % setup)
    elif not encrypted:
        checks.fail("group_vars/all/vault.yml isn't encrypted", "%s replaces it with an encrypted one" % setup)
    else:
        checks.ok("the vault", "encrypted")
    extra = vault_args(inv) + extra

    if purpose == "build":
        staging = inv.literal("artifact_staging", "/var/staging/artifacts")
        sha = inv.literal("harbor_installer_sha256", "")
        installer = inv.literal("harbor_installer_file", "")
        if not sha or PLACEHOLDER.search(sha):
            checks.fail("the Harbor files aren't staged for %s yet" % env,
                        "python3 kit publish --from <transfer folder> --env %s" % env)
        else:
            source = "repo" if inv.vars.get("nexus_enabled") is True else "staged"
            if source == "staged" and installer and not os.path.isfile(os.path.join(staging, "harbor", installer)):
                checks.fail("%s isn't in %s" % (installer, os.path.join(staging, "harbor")),
                            "python3 kit publish --from <transfer folder> --env %s" % env)
            else:
                checks.ok("Harbor %s staged" % inv.literal("harbor_version", ""), os.path.join(staging, "harbor"))
                for problem in kit_mismatches(os.path.join(staging, "harbor"), inv):
                    checks.fail(problem.split(". ")[0], problem.split(". ", 1)[1] if ". " in problem else setup)
        name = inv.literal("harbor_hostname", "")
        if inv.literal("harbor_tls_mode", "staged") == "ipa":
            if local and not os.path.isfile("/etc/ipa/default.conf"):
                checks.fail("IdM issues the certificate, but this machine isn't an IdM client",
                            "%s, and answer no to IdM issuing it" % setup)
            else:
                checks.ok("certificate", "issued by IdM during the build")
        else:
            staged = staged_tls(inv, staging, name)
            tls = os.path.dirname(staged[0])
            missing = [p for p in staged if p and not os.path.isfile(p)]
            if missing:
                checks.fail("the certificate isn't staged: there's no %s" % ", ".join(missing),
                            "%s, and give it the certificate, key and CA" % setup)
            else:
                problems, notes = cert_problems(staged[0], staged[1], staged[2], name)
                for problem in problems:
                    checks.fail("the certificate for %s: %s" % (name, problem), "%s, and give it the right files" % setup)
                for note in notes:
                    checks.warn("the certificate for %s: %s" % (name, note))
                if not problems:
                    checks.ok("certificate for %s" % name, tls)
    return checks.problems, extra


def run_playbook(env, playbook, extra):
    """ansible-playbook from the repository, always with its ansible.cfg, even where Ansible would
    skip it (a world-writable folder such as /mnt/c under WSL)."""
    cmd = ["ansible-playbook", "-i", os.path.join("inventories", env, "hosts"), "--diff"] + extra + [playbook]
    log("$ " + " ".join(shlex.quote(c) for c in cmd))
    return subprocess.call(cmd, cwd=REPO, env=dict(os.environ, ANSIBLE_CONFIG=os.path.join(REPO, "ansible.cfg")))


